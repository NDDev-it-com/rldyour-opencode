# OS files
.DS_Store
Thumbs.db

# Secrets and credentials
.env
.env.*
!.env.example
credentials.json
*.pem
*.key
*.secret

# Logs
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo

# Node
node_modules/

# OpenCode plugin dependencies
.opencode/node_modules/

# Serena runtime markers (must never be committed or published to fullrepo).
# Matches the local-only set in scripts/fullrepo_sync.sh RUNTIME_EXCLUDE_PATTERNS
# so normal-branch git and fullrepo publish stay aligned.
.serena/cache/
.serena/project.local.yml
.serena/.gitignore
.serena/.flow_*
.serena/.sync_marker
.serena/.serena_sync_state.json
.serena/.auto_sync_head
.serena/.active_workflow_intent.json
.serena/.dirty_stop_ack
.serena/.command_audit.log

# Browser / Webwright / Playwright CLI runtime artifacts
browser/**
!browser/
!browser/.gitkeep
.playwright-cli/
.playwright-mcp/
playwright-report/
test-results/
.webwright-runs/
outputs/webwright/
final_runs/
**/final_script_log.txt
**/trajectory.json
**/raw_responses.jsonl
**/screenshots/*.png
**/screenshots/*.jpg
**/screenshots/*.jpeg
**/screenshots/*.webp

# Diagnostic bundles (scripts/collect_diagnostics.sh output)
diagnostics/

# OpenCode local config (user-specific)
.opencode/local.json

# AI workflow directories (managed via fullrepo branch)
.claude/
.cursor/
.windsurf/
.roo/
.aider*
.agents/
