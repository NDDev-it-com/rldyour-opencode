# Required: MCP servers that need authentication
CONTEXT7_API_KEY=ctx7sk_...
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# Optional: Serena MCP (defaults to project-from-cwd if not set)
# SERENA_PROJECT_ROOT=.

# Optional: Sequential Thinking MCP logging (default: true, set to "true" to enable)
# DISABLE_THOUGHT_LOGGING=true

# Optional: OpenCode provider keys (used by OpenCode itself, not MCP)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...