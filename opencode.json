{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.1",
  "small_model": "opencode-go/glm-5.1",
  "default_agent": "build",
  "autoupdate": "notify",
  "share": "manual",
  "snapshot": true,
  "shell": "/bin/bash",
  "lsp": {
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "vscode-html": {
      "command": [
        "vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".htm"
      ]
    },
    "vscode-css": {
      "command": [
        "vscode-css-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css",
        ".scss",
        ".sass",
        ".less"
      ]
    },
    "vscode-json": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "docker": {
      "command": [
        "docker-language-server",
        "start",
        "--stdio"
      ],
      "extensions": [
        ".dockerfile"
      ]
    },
    "taplo": {
      "command": [
        "taplo",
        "lsp",
        "stdio"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "marksman": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md",
        ".mdx",
        ".markdown"
      ]
    },
    "qmlls": {
      "command": [
        "qmlls"
      ],
      "extensions": [
        ".qml"
      ]
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "doom_loop": "allow",
        "skill": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "doom_loop": "allow",
        "skill": "allow"
      }
    },
    "title": {
      "temperature": 0.2
    },
    "summary": {
      "temperature": 0.2
    },
    "compaction": {
      "temperature": 0.2
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent==1.5.3",
        "--python",
        "3.13",
        "--prerelease",
        "allow",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context=agent",
        "--enable-web-dashboard",
        "False",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "bunx",
        "@modelcontextprotocol/server-sequential-thinking@2025.12.18"
      ],
      "enabled": true,
      "environment": {
        "DISABLE_THOUGHT_LOGGING": "true"
      },
      "timeout": 30000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "chrome-devtools-mcp@1.4.0",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "timeout": 15000
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 15000
    },
    "shadcn": {
      "type": "local",
      "command": [
        "bunx",
        "shadcn@4.12.0",
        "mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "dart-flutter": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server",
        "--force-roots-fallback"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users"
      },
      "timeout": 15000
    },
    "openai-docs": {
      "type": "remote",
      "url": "https://developers.openai.com/mcp",
      "enabled": true,
      "timeout": 15000
    }
  },
  "instructions": [
    "AGENTS.md",
    "references/public-repo-ci-policy.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 12,
    "preserve_recent_tokens": 8000,
    "reserved": 4000
  },
  "plugin": [],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "browser/**",
      ".serena/cache/**",
      ".opencode/node_modules/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      ".cache/**",
      ".venv/**",
      "**/*.log"
    ]
  }
}
