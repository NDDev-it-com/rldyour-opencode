{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",
  "small_model": "anthropic/claude-haiku-4-20250514",
  "autoupdate": true,
  "share": "manual",
  "snapshot": true,
  "shell": "/bin/zsh",
  "lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "vscode-html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html", ".htm"]
    },
    "vscode-css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".sass", ".less"]
    },
    "vscode-json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "docker": {
      "command": ["docker-language-server", "start", "--stdio"],
      "extensions": [".dockerfile"]
    },
    "taplo": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    },
    "marksman": {
      "command": ["marksman", "server"],
      "extensions": [".md", ".mdx", ".markdown"]
    },
    "qmlls": {
      "command": ["qmlls"],
      "extensions": [".qml"]
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "glob": "allow",
    "grep": "allow",
    "read": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-20250514",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "task": "allow",
        "todowrite": "allow",
        "question": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-20250514",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow"
      }
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["uvx", "--from", "serena-agent==1.3.0", "--python", "3.13", "--prerelease", "allow", "serena", "start-mcp-server", "--project-from-cwd", "--context=agent", "--enable-web-dashboard", "False", "--open-web-dashboard", "False"],
      "enabled": true,
      "timeout": 30000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["bunx", "@modelcontextprotocol/server-sequential-thinking@2025.12.18"],
      "enabled": true,
      "environment": {
        "DISABLE_THOUGHT_LOGGING": "true"
      },
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "@playwright/mcp@0.0.75", "--headless", "--caps=network,storage,testing,devtools"],
      "enabled": true,
      "timeout": 30000
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["bunx", "chrome-devtools-mcp@0.25.0", "--headless", "--isolated", "--no-usage-statistics", "--no-performance-crux"],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "timeout": 15000
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 15000
    },
    "semgrep": {
      "type": "local",
      "command": ["uvx", "--from", "semgrep==1.162.0", "semgrep", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "shadcn": {
      "type": "local",
      "command": ["bunx", "shadcn@4.7.0", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "dart-flutter": {
      "type": "local",
      "command": ["dart", "mcp-server", "--force-roots-fallback"],
      "enabled": true,
      "timeout": 30000
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "timeout": 15000
    },
    "openai-docs": {
      "type": "remote",
      "url": "https://developers.openai.com/mcp",
      "enabled": true,
      "timeout": 15000
    }
  },
  "instructions": ["AGENTS.md"],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "plugin": [],
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "browser/**"]
  }
}